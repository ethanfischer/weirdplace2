# Blender backup files
*.blend1

# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

Plugins/UnrealMCP/
nul

# Claude Code local settings (user-specific paths)
.claude/settings.local.json

# Rider user-specific settings (absolute/local paths)
*.DotSettings.user
.claude/scheduled_tasks.lock
Packaged

# Throwaway editor-interaction Python scripts written by Claude
scripts/local/

# VHS cover generator outputs / caches (generated by tools/vhs_cover_gen.py)
tools/generated_covers/
tools/photo_cache/
tools/fonts/
__pycache__/
tools/cover_preview.png
tools/test_photo.jpg
NIGHTLY_REPORT.md
Content/BUILDINGS/VOL3_Attachments
Content/Roadside/VOL2
Content/Suburban_Household

# JVM crash/replay dumps (Rider/JetBrains) \u2014 never check in
replay_pid*.log
hs_err_pid*.log

# Stray logs anywhere (UE logs already ignored via Saved/*)
*.log
